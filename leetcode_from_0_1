class Solution1:
    def mergeAlternately(self, word1: str, word2: str) -> str:
        # 先判断哪个短，然后遍历交替添加；再次判断哪个剩下来加到末尾
        
        min_len = min(len(word1), len(word2))
        newstr = []

        for i in range(min_len):
            newstr.append(word1[i])
            newstr.append(word2[i])
        
        if len(word1)>len(word2):
            newstr = newstr+ list(word1[min_len:])

        else:
            newstr = newstr+ list(word2[min_len:])

        return("".join(newstr))

    def elegant(self, word1: str, word2: str) -> str:
        # 不用判断，直接打包循环遍历，最后直接加

        res = []
        for c1, c2 in zip(word1, word2):
            res.append(c1 + c2)
        # 拼接配对部分 + 两个字符串剩余尾部（其中一个一定是空）
        return "".join(res) + word1[len(word2):] + word2[len(word1):]



"""
给定两个字符串 s 和 t ，它们只包含小写字母。
字符串 t 由字符串 s 随机重排，然后在随机位置添加一个字母。
请找出在 t 中被添加的字母。
"""
#统计每个字母出现次数，找出 t 比 s 多 1 次的字符：
#利用Counter创建统计字典
from collections import Counter
class Solution2:
    def findTheDifference(self, s: str, t: str) -> str:
        cns = Counter(s)
        cnt = Counter(t)
        for char, num in cnt.items():
            if cns[char] != num :
                return char


