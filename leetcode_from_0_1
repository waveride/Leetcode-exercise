"""
242. 有效的字母异位词
给定两个字符串 s 和 t ，编写一个函数来判断 t 是否是 s 的 字母异位词。
"""
# 优化思路
# 1. 使用字典统计每个字符出现的次数
# 2. 遍历两个字符串，比较字符出现次数是否一致
def solution242(s: str, t: str) -> bool:
    if len(s) != len(t):
        return False
    count = {}
    for char in s:
        count[char] = count.get(char, 0) + 1  # 计数有返回次数，没有返回0
    for char in t:
        if char not in count:
            return False
        count[char] -= 1
        if count[char] < 0:
            return False
    return True

"""
给定一个非空的字符串 s ，检查是否可以通过由它的一个子串重复多次构成。
"""
def solution459(s: str) -> bool:
    # 1. 先判断字符串长度是否为1，如果是，直接返回True
    if len(s) == 1:
        return True
    # 2. 遍历字符串的前一半长度，判断是否存在重复子串
    for i in range(1, len(s) // 2 + 1):
        if len(s) % i == 0:  # 如果长度可以整除
            if s[:i] * (len(s) // i) == s:  # 判断重复子串是否等于原字符串
                return True
    return False

